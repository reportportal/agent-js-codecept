{
  "name": "@reportportal/agent-js-codecept",
  "version": "1.0.0",
  "description": "Agent for integration CodeceptJS with ReportPortal.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/reportportal/agent-js-codecept.git"
  },
  "keywords": [
    "codeceptJS",
    "codeceptjs",
    "browserstack",
    "codeceptjs-reportportal",
    "codeceptjs-rphelper"
  ],
  "author": "Thanh Nguyen <peter.nguyentr@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/reportportal/agent-js-codecept/issues"
  },
  "homepage": "https://github.com/reportportal/agent-js-codecept#readme",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "/build"
  ],
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@reportportal/client-javascript": "~5.6.0",
    "debug": "^4.3.4",
    "lodash.clonedeep": "^4.5.0"
  },
  "peerDependencies": {
    "codeceptjs": ">=3.0.0 <4"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "codegraph": "bash scripts/codegraph.sh",
    "clean": "rimraf ./build",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,js}\" \"__tests__/**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.{ts,js}"
    ]
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/jest": "^29.5.12",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "codeceptjs": "~3.7.9",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.5"
  }
}
